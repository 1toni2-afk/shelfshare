# Node
node_modules/
dist/
coverage/

# Python
__pycache__/
*.pyc

# Env
.env
.env.local
.env.production

# Logs
*.log
# Jurnalul global al aplicatiei (backend/src/activity-log) - fisiere pe zile,
# scrise in rulare; volumul din docker-compose le tine pe host.
logs/
npm-debug.log*
pnpm-debug.log*

# Prisma
backend/prisma/*.db

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Docker volumes locale (dacă apar mount-uri locale de test)
postgres_data/

# pnpm cache local, nu trebuie versionat
.pnpm-store/

# Artefact local de build TypeScript incremental. Versionat din greșeală, a
# rupt build-ul Docker: tsc credea că output-ul e deja generat și nu emitea
# dist/ (vezi backend/.dockerignore).
*.tsbuildinfo

# Output generat de scraper-ul de enrichment (nu se versioneaza)
scripts/book-enrichment/enriched*.json
scripts/book-enrichment/isbns*.txt
scripts/book-enrichment/attempted_isbns.txt
scripts/book-enrichment/nightly_state.json
scripts/book-enrichment/nightly_runs/
scripts/book-enrichment/run*.log
scripts/book-enrichment/debug_pages*/
# Indexul libris (~8 MB, regenerabil cu enrich_libris.py --build-index)
scripts/book-enrichment/libris_index.json
scripts/book-enrichment/libris_*.txt
# Catalogul scrapuit si copertile lui (~2,4 MB JSON + 1900 de fisiere, ~84 MB).
# Regenerabile de nightly_run.py din enriched_all.json, deci intra in git doar
# ca greutate permanenta in istoric si in fiecare clona. Aceeasi regula ca la
# scripts/targulcartii/data/. Importul in prod nu citeste din git: catalogul e
# montat read-only in container (vezi docker-compose.prod.yml) si incarcat cu
# `docker exec shelfshare-backend-1 node prisma/import-scp-db.js`.
scripts/book-enrichment/ShelfShare_SCP_DB.json
scripts/book-enrichment/ShelfShare_SCP_DB_covers/
