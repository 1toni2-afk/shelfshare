// ShelfShare - Prisma Schema
// Milestone 2: câmpurile necesare pentru autentificare.
// Milestone 3: câmpurile de profil.
// Milestone 4: catalogul de cărți + biblioteca personală.
// Milestone 5: genre pentru filtrarea la căutare.
// Milestone 6: cererile de schimb.
// Milestone 7: conversații și mesaje.
// Milestone 8: wishlist + notificări.
// Milestone 9: câmpuri admin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?

  isEmailVerified   Boolean   @default(false)
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?

  resetPasswordToken  String?
  resetPasswordExpiry DateTime?

  // Email abuse protection (Milestone 17): cooldown + daily cap shared by
  // verification and reset emails, per the "10 emailuri/zi" checklist item.
  lastAuthEmailSentAt  DateTime?
  authEmailWindowStart DateTime?
  authEmailSentCount   Int       @default(0)

  // Account lockout (Milestone 17): temporary lock after repeated failed
  // logins, reset to 0 on a successful login or password reset.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  refreshTokenHash String?

  googleId String? @unique

  name         String?
  username     String? @unique
  nameVisible  Boolean @default(true)
  city         String?
  bio          String?
  profileImage String?

  rating              Float @default(0)
  booksExchangedCount Int   @default(0)
  booksSharedCount    Int   @default(0)
  booksReceivedCount  Int   @default(0)

  // Medii pe dimensiuni, calculate din ExchangeRequest.*RatingFor* - vezi
  // recomputeRating în exchanges.service.ts. Rămân 0 până la prima evaluare
  // primită pe dimensiunea respectivă (conditionRating poate rămâne 0 mult
  // timp, fiindcă se dă doar de cine chiar primește o carte, nu la orice
  // schimb - ex. un schimb cu bani în loc de carte).
  avgCommunicationRating Float @default(0)
  avgPunctualityRating   Float @default(0)
  avgConditionRating     Float @default(0)

  lastActiveAt DateTime?

  // Momentul ultimei deconectări de la socket-ul de chat - baza pentru
  // „Last seen" din conversație. Diferit de lastActiveAt, care se atinge la
  // orice request HTTP autentificat (inclusiv polling de fundal) și deci e
  // prea „optimist" ca să arate dacă omul chiar e la telefon acum.
  // Prezența live (online/offline) NU se stochează - vezi ChatGateway.
  lastSeenAt DateTime?

  // Reading Streak - zile consecutive cu activitate (vezi JwtAuthGuard),
  // calculat pe zi calendaristică, nu pe fereastră de 24h.
  currentStreakDays Int       @default(0)
  longestStreakDays Int       @default(0)
  lastStreakDate    DateTime?

  // XP & Levels - punctele se acumulează la acțiuni cheie deja existente
  // (listare carte, schimb finalizat, vânzare acceptată, recenzie scrisă);
  // nivelul se calculează din xp, nu se stochează separat (vezi
  // levelForXp în profile.service.ts).
  xp Int @default(0)

  // Reading Challenge - obiectiv anual opțional, setat de user; progresul
  // se calculează din BookshelfEntry cu status FINISHED din anul curent,
  // nu e stocat separat.
  readingChallengeGoal Int?

  // Profilul de cititor, completat la primul login (vezi ReadingSurveyService).
  // Alimentează recomandările și notificarea „carte nouă pe gustul tău".
  //
  // Genurile sunt liste de text, nu un enum: valorile din `books.genre` vin din
  // surse externe (OpenLibrary/Google Books) și nu putem garanta că se
  // încadrează într-un set fix. Lista propusă în UI stă în
  // common/constants/book-genres.ts.
  favoriteGenres  String[] @default([])
  favoriteAuthors String[] @default([])

  // Câte cărți citește pe lună, ca text scurt („1", "2-3", "4+"). Momentan
  // doar informativ pentru profil - nu intră în algoritmul de recomandare.
  readingPace String?

  // Marcat și când userul sare peste chestionar: altfel l-am întreba la
  // fiecare pornire pe cineva care a refuzat deja o dată.
  readingSurveyCompletedAt DateTime?

  // Scopul declarat la onboarding (swap/sell/discover/all) - doar informativ,
  // nu are impact funcțional încă.
  onboardingPurpose String?

  isAdmin  Boolean @default(false)
  isBanned Boolean @default(false)

  // Admin Control Panel (Milestone 19) - rol granular, în plus față de
  // isAdmin. isAdmin rămâne derivat (true <=> adminRoleId != null) ca să nu
  // trebuiască rescrise dintr-o dată toate verificările existente de
  // `user.isAdmin` din cod - vezi AdminGuard vs PermissionGuard.
  adminRoleId String?
  adminRole   AdminRole? @relation("UserAdminRole", fields: [adminRoleId], references: [id])

  // Premium (Milestone 5) - doar flag + acordare manuală din admin panel,
  // fără procesare de plăți reale (vezi togglePremium în admin.service.ts).
  isPremium Boolean @default(false)

  // Supporter (Milestone 13) - userii care au donat prin „Keep the app alive".
  // Momentul donației, nu un boolean, ca să putem afișa „supporter din <lună>"
  // și eventual să expirăm insigna pe viitor. Acordat manual din admin panel
  // până există integrarea de plăți (Google Play Billing / PayPal); vezi
  // toggleSupporter în admin.service.ts și badge-ul „supporter" din
  // profile.service.ts.
  supporterSince DateTime?

  // Ziua de naștere, doar zi + lună (Milestone 14) - folosită exclusiv pentru
  // mesajul „La mulți ani" din salutul paginii principale. Intenționat FĂRĂ an:
  // pentru un salut nu ne trebuie vârsta, iar ce nu stocăm nu trebuie nici
  // protejat, nici declarat la Data Safety. Ambele sunt setate sau ambele NULL.
  birthdayDay   Int?
  birthdayMonth Int?

  // Limbile în care userul citește (Milestone 18) - afișate pe card-ul „Despre"
  // din profilul lateral. Nu au impact funcțional (nu filtrează căutări),
  // sunt doar informative, deci lista e liberă. Default „Română" ca 99% din
  // userii țintă să nu trebuiască să seteze nimic manual.
  languages String[] @default(["Română"])

  showAcquisitionHistory Boolean @default(false)

  // Confidențialitatea anunțurilor (Milestone 24): userul poate ascunde din
  // rezultatele publice (căutare/discover) anunțurile după tip - de ex. să
  // păstreze vânzările publice dar donațiile private. Un anunț poate fi
  // simultan de mai multe tipuri (ex. disponibil și la schimb, și la vânzare -
  // vezi comentariul despre `availableForSwap`/`isForSale` de pe UserBook),
  // deci vizibilitatea publică se calculează per-tip la interogare, nu ca un
  // singur boolean pe anunț. Butonul „Fă tot privat" din Settings setează
  // toate cele patru pe true dintr-un singur apel - nu există un flag global
  // separat, ca să nu trebuiască ținut sincronizat cu cele patru individuale.
  hideSwapListingsPublic     Boolean @default(false)
  hideSaleListingsPublic     Boolean @default(false)
  hideDonationListingsPublic Boolean @default(false)
  hideAuctionListingsPublic  Boolean @default(false)

  /// Preferință per-admin pentru badge-ul de scor de pe cardurile de carte
  /// (vezi BooksController#POST /books/scores): false (implicit) = badge doar
  /// pe cărțile din top 256 după popularityScore; true = badge pe orice carte
  /// cu scor. Fără efect pentru userii ne-admin - ei nu văd niciodată scorul.
  showAllListingScores Boolean @default(false)

  // Book Match (swipe) - starea profilului de swipe. Vezi BookMatchService.
  // Cât timp onboardingSwipesCount < 50 suntem în „cold start": coada vine
  // dintr-un pool curatoriat pe genuri, iar fiecare swipe contează mai mult
  // (multiplicatorul de popularitate). Contorul se oprește la 50, nu e un
  // total pe viață - numărul total de swipe-uri se poate afla oricând din
  // book_swipes.
  onboardingSwipesCount         Int       @default(0)
  // Ultima recalibrare („resetează-mi gusturile") - cooldown 30 de zile.
  lastRecalibrationAt           DateTime?
  // Câte swipe-uri mai primesc raport crescut de discovery după recalibrare.
  discoveryBoostSwipesRemaining Int       @default(0)

  referralCode String? @unique
  invitedById  String?
  invitedBy    User?   @relation("Referrals", fields: [invitedById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Referrals")

  // Ștergere de cont amânată 15 zile (cerință Google Play + politică de
  // „cooling off"): user cere ștergerea → setăm timestamp-ul → un cron zilnic
  // șterge efectiv contul după expirare. NULL = neprogramat. Anularea = set
  // pe NULL. Vezi AccountDeletionService.
  deletionScheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBooks                UserBook[]
  sentExchangeRequests     ExchangeRequest[]         @relation("RequesterExchanges")
  receivedExchangeRequests ExchangeRequest[]         @relation("OwnerExchanges")
  conversationsAsUserA     Conversation[]            @relation("ConversationUserA")
  conversationsAsUserB     Conversation[]            @relation("ConversationUserB")
  messagesSent             Message[]                 @relation("MessageSender")
  wishlistItems            WishlistItem[]
  savedSearches            SavedSearch[]
  bookOfMonthVotes         BookOfMonthVote[]
  readingProgress          ReadingProgress[]
  reviews                  Review[]
  notifications            Notification[]
  deviceTokens             DeviceToken[]
  blocksMade               Block[]                   @relation("BlockBlocker")
  blocksReceived           Block[]                   @relation("BlockBlocked")
  reportsMade              Report[]                  @relation("ReportReporter")
  reportsReceived          Report[]                  @relation("ReportReported")
  reportsAssigned          Report[]                  @relation("ReportAssignee")
  adminSupportConversation AdminSupportConversation?
  adminSupportMessagesSent AdminSupportMessage[]     @relation("AdminSupportMessageSender")
  offersMade               PriceOffer[]              @relation("OfferBuyer")
  offersReceived           PriceOffer[]              @relation("OfferOwner")
  following                Follow[]                  @relation("FollowFollower")
  followers                Follow[]                  @relation("FollowFollowing")
  feedback                 Feedback[]
  bookViews                BookView[]
  listingScoreEvents       ListingScoreEvent[]
  bookshelfEntries         BookshelfEntry[]
  auctionBids              Bid[]                     @relation("AuctionBidder")
  auctionsWon              Auction[]                 @relation("AuctionHighestBidder")
  auctionWatches           AuctionWatch[]
  collections              Collection[]
  createdGroups            Group[]                   @relation("GroupCreator")
  groupMemberships         GroupMember[]
  groupPosts               GroupPost[]
  securityEvents           SecurityEvent[]
  featureFlags             UserFeatureFlag[]
  bookSwipes               BookSwipe[]
  genreScores              UserGenreScore[]
  authorScores             UserAuthorScore[]
  eraScores                UserEraScore[]
  recalibrationLogs        RecalibrationLog[]

  @@map("users")
}

model Feedback {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message  String
  photoUrl String?

  createdAt DateTime @default(now())

  @@map("feedback")
}

/// Mesaje de la useri care nu se pot loga (deci fără cont autentificat) -
/// trimise din ecranul de login, protejate cu un captcha simplu în loc de
/// serviciu extern (vezi support.service.ts).
model SupportRequest {
  id String @id @default(uuid())

  name    String
  email   String
  phone   String?
  message String

  createdAt DateTime @default(now())

  @@map("support_requests")
}

model Follow {
  id String @id @default(uuid())

  followerId String
  follower   User   @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

model Block {
  id String @id @default(uuid())

  blockerId String
  blocker   User   @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

/// Motivele de raportare. Lista e una singura in baza de date, dar se ofera
/// DIFERIT in functie de ce se raporteaza (vezi REPORT_REASONS_BY_TARGET din
/// reports.constants.ts): pentru continut - spam / limbaj abuziv / continut
/// fals / continut inadecvat / altul; pentru un user - comportament abuziv /
/// frauda / profil fals / altul. Un singur enum, fiindca `Report` e un singur
/// model, iar panoul de moderare filtreaza oricum dupa tipul tintei.
enum ReportReason {
  SPAM
  SCAM
  INAPPROPRIATE
  /// „Comportament abuziv" cand tinta e un user.
  HARASSMENT
  OTHER
  ABUSIVE_LANGUAGE
  FALSE_CONTENT
  FAKE_PROFILE
}

/// Ce anume s-a raportat. Stocat pe langa cheile straine tipate de mai jos,
/// nu in locul lor: cheile pastreaza integritatea referentiala si stergerea in
/// cascada, iar perechea (targetType, targetId) da ce nu se poate face cu ele -
/// numaratul rapoartelor pe aceeasi tinta, indiferent de tip (auto-hide) si
/// unicitatea „un user raporteaza o tinta o singura data".
enum ReportTargetType {
  USER
  LISTING
  REVIEW
  /// Raportarea unei conversatii pastreaza un snapshot al intregului
  /// transcript (vezi Report.transcriptPath), nu un singur mesaj.
  CONVERSATION
  GROUP_POST
  EXCHANGE
}

/// Coadă de moderare pentru Report (Batch "Report status & assignee") - fără
/// asta, doi moderatori puteau lucra pe același raport fără să se vadă, iar
/// un raport tratat arăta identic cu unul netratat.
enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model Report {
  id String @id @default(uuid())

  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUserId String
  reportedUser   User   @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  reason  ReportReason
  details String?

  userBookId String?
  userBook   UserBook? @relation(fields: [userBookId], references: [id], onDelete: SetNull)

  // Setate doar când raportul pleacă dintr-o conversație: la raportare
  // exportăm transcriptul ca fișier text în storage (folderul chat-reports/)
  // și păstrăm calea aici. Snapshot, nu link viu - dacă ulterior se șterge
  // conversația, dovada rămâne. Vezi ConversationsService#reportConversation.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  transcriptPath String?

  // Feature backlog #18: moderation queue also covers GroupPost + Review,
  // which had no report/hide flow before this - reuses the same Report
  // model/status workflow instead of a parallel one per content type.
  groupPostId String?
  groupPost   GroupPost? @relation(fields: [groupPostId], references: [id], onDelete: SetNull)

  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  /// Tinta, in forma pe care se poate numara si filtra. Derivata din cheile
  /// straine de mai sus la creare (vezi ReportsService.create) - nu se scrie
  /// niciodata direct din afara serviciului, ca sa nu poata ajunge sa nu mai
  /// corespunda cu ele.
  targetType ReportTargetType
  targetId   String

  status         ReportStatus @default(OPEN)
  assignedToId   String?
  assignedTo     User?        @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())

  /// Un user poate raporta o tinta O SINGURA data. Fara asta, cineva putea
  /// trimite acelasi raport de zece ori si declansa singur auto-hide-ul.
  @@unique([reporterId, targetType, targetId])
  @@index([status])
  /// Pragurile de auto-hide numara rapoartele distincte pe aceeasi tinta
  /// intr-o fereastra de timp - vezi ReportsService.applyAutoHide.
  @@index([targetType, targetId, createdAt])
  @@map("reports")
}

model UpcomingRelease {
  id String @id @default(uuid())

  title       String
  author      String?
  coverUrl    String?
  description String?
  isbn        String?
  releaseDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("upcoming_releases")
}

enum BookCondition {
  NOUA
  FOARTE_BUNA
  BUNA
  ACCEPTABILA
}

model Book {
  id String @id @default(uuid())

  isbn          String? @unique
  title         String
  author        String?
  description   String?
  coverUrl      String?
  publisher     String?
  publishedYear Int?
  pageCount     Int?
  language      String?
  genre         String?

  /// Feature backlog #7 - "ai volumul 1, ești anunțat când apare volumul 2".
  /// Fără sursă externă de încredere (Open Library/Google Books nu dau date
  /// structurate de serie - vezi comentariul despre etichetele "series:x"
  /// filtrate în book-lookup.service.ts), completate manual de user la
  /// listare, la fel ca genre pentru cărțile fără ISBN găsit extern.
  series       String?
  seriesNumber Int?

  referencePrice         Decimal? @db.Decimal(10, 2)
  referencePriceCurrency String?

  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Book Match: cât de „cunoscută" e cartea, folosită doar ca multiplicator
  /// la cold start (primele 50 de swipe-uri), unde încă nu avem semnal de la
  /// user și vrem ca titlurile mari să tragă mai tare profilul într-o direcție.
  /// NULL = necurat, se folosește BOOK_MATCH_DEFAULT_POPULARITY.
  popularityScore Float?

  userBooks        UserBook[]
  wishlistItems    WishlistItem[]
  bookshelfEntries BookshelfEntry[]
  collectionItems  CollectionItem[]
  swipes           BookSwipe[]
  bookOfMonthVotes BookOfMonthVote[]
  readingProgress  ReadingProgress[]
  reviews          Review[]

  @@index([series])
  /// Book Match cade pe interogări exacte per gen când eșantionul aleator nu
  /// nimerește genurile rămase servibile (vezi `exactCandidates`): index range
  /// scan pe (gen, id) dintr-un punct aleator, în loc de seq scan pe tot
  /// catalogul importat.
  @@index([genre, id])
  @@map("books")
}

/// "Collections" (Milestone 5) - liste curate de cărți, definite liber de
/// user (ex. "Favorite", "De recitit") - distinct de BookshelfEntry (status
/// fix de citit) și de WishlistItem (cărți dorite, nu neapărat deținute).
/// O carte poate apărea în mai multe colecții ale aceluiași user.
model Collection {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isPublic    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  id String @id @default(uuid())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([collectionId, bookId])
  @@map("collection_items")
}

enum GroupRole {
  ADMIN
  MEMBER
}

/// "Groups" (Milestone 5) - unifică Book Clubs, Reading Groups și Community
/// Events într-o singură entitate: un grup are membri, un fir de discuții
/// (GroupPost) și, opțional, evenimente programate (GroupEvent) - în loc de
/// 3 modele aproape identice pentru concepte care se suprapun oricum.
model Group {
  id String @id @default(uuid())

  name        String
  description String?

  creatorId String
  creator   User   @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GroupMember[]
  posts   GroupPost[]
  events  GroupEvent[]

  @@map("groups")
}

model GroupMember {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@map("group_members")
}

model GroupPost {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String

  /// Ascuns automat de sistemul de moderare dupa ce a strans destule rapoarte
  /// (vezi ReportsService.applyAutoHide). Distinct de stergere: continutul
  /// ramane in baza pentru moderatorul care il judeca, si poate fi repus.
  hiddenAt DateTime?

  createdAt DateTime @default(now())

  reports Report[]

  @@map("group_posts")
}

/// Întâlniri/evenimente opționale ale grupului ("Community Events" din
/// checklist) - fără RSVP separat, doar o listă cronologică vizibilă
/// membrilor, la fel de simplu ca restul funcției.
model GroupEvent {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title       String
  description String?
  eventAt     DateTime
  location    String?

  createdAt DateTime @default(now())

  @@map("group_events")
}

// Admin Control Panel (Milestone 19) - roluri de admin cu permisiuni
// granulare. 4 roluri predefinite (SUPER_ADMIN/MODERATOR/CONTENT_MODERATOR/
// USER_SUPPORT) + CUSTOM pentru roluri create manual din admin panel. Vezi
// admin/constants/admin-permissions.ts pentru catalogul de permisiuni.
enum AdminRoleName {
  SUPER_ADMIN
  MODERATOR
  CONTENT_MODERATOR
  USER_SUPPORT
  CUSTOM
}

model AdminRole {
  id          String        @id @default(uuid())
  name        AdminRoleName
  // Nume afișat - obligatoriu semnificativ pentru CUSTOM; pentru rolurile
  // predefinite reflectă pur și simplu numele enumului.
  label       String
  permissions String[]      @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins User[] @relation("UserAdminRole")

  @@map("admin_roles")
}

/// "Cartea lunii" (feature backlog #11) - vot comunitar simplu, un vot per
/// user per lună (`month`, format "YYYY-MM" - text simplu, ușor de comparat/
/// grupat, fără să tragem un întreg tip Date doar pentru o cheie de lună).
/// Câștigătorul se calculează la citire (groupBy pe voturile lunii curente,
/// vezi BookOfMonthService#getCurrentWinner) - nu există un rând separat de
/// „câștigător", ca să nu se poată dezincroniza de voturile reale.
model BookOfMonthVote {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  month String

  createdAt DateTime @default(now())

  @@unique([userId, month])
  @@index([month, bookId])
  @@map("book_of_month_votes")
}

/// Progres de lectură per user/carte (feature backlog #15) - "la pagina X
/// din Y". Distinct de BookshelfEntry (doar statusul READING/WANT_TO_READ/
/// FINISHED) - poți fi "Reading" fără să fi introdus niciodată o pagină.
/// Nu declanșează XP la fiecare update (ar fi ușor de exploatat prin
/// actualizări repetate) - streak-ul de citit se actualizează deja separat,
/// la orice request autentificat (vezi JwtAuthGuard#updateActivityAndStreak).
model ReadingProgress {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  currentPage Int

  /// Numărul total de pagini al EDIȚIEI pe care o are userul în mână, când
  /// diferă de `Book.pageCount` (ediția din catalog). Null = folosim
  /// `Book.pageCount`. Nu scriem peste `Book.pageCount`, care e partajat între
  /// toți userii care au aceeași carte în catalog.
  totalPages Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@map("reading_progress")
}

/// Recenzie comunitară per titlu (feature backlog #16) - notă + text scurt
/// de la useri reali, agregate pe pagina cărții. Distinctă de `Book.rating`
/// implicit inexistent (nu există notă externă pe Book) și de `User.rating`
/// (scorul de încredere al vânzătorului, calculat din schimburi - vezi
/// recomputeRating în exchanges.service.ts) - aici notăm CARTEA, nu omul.
/// O singură recenzie per user per carte (upsert, nu istoric de recenzii).
model Review {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  rating Int
  text   String?

  /// Ascuns automat de sistemul de moderare dupa ce a strans destule rapoarte
  /// (vezi ReportsService.applyAutoHide). Distinct de stergere: continutul
  /// ramane in baza pentru moderatorul care il judeca, si poate fi repus.
  hiddenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("reviews")
}

/// Snapshot zilnic al panoului de admin (feature backlog #10) - getStats()
/// întoarce numere absolute la fiecare cerere; aici păstrăm un rând pe zi,
/// scris de un cron (vezi AdminService#snapshotDailyStats), ca panoul să
/// poată arăta creșterea în timp, nu doar starea curentă.
model StatsSnapshot {
  id String @id @default(uuid())

  date DateTime @unique @db.Date

  totalUsers         Int
  verifiedUsers      Int
  totalBooks         Int
  totalListings      Int
  totalExchanges     Int
  completedExchanges Int

  createdAt DateTime @default(now())

  @@map("stats_snapshots")
}

model UserBook {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  condition        BookCondition
  language         String?
  edition          String?
  isHardcover      Boolean       @default(false)
  availableForSwap Boolean       @default(true)

  isForSale    Boolean  @default(false)
  salePrice    Decimal? @db.Decimal(10, 2)
  isNegotiable Boolean  @default(true)

  /// Prețul de dinaintea ultimei REDUCERI, ca anunțul să poată arăta prețul
  /// vechi tăiat lângă cel nou. NULL când nu e vorba de o reducere: preț pus
  /// prima dată, preț crescut, sau anunț scos de la vânzare.
  previousSalePrice Decimal? @db.Decimal(10, 2)

  /// Când a fost schimbat ultima dată `salePrice`. Impune cooldown-ul de 72h
  /// între două modificări de preț (PRICE_UPDATE_COOLDOWN_MS în
  /// books.service.ts) - fără el, un anunț putea „oscila" prețul zilnic ca să
  /// pară mereu redus.
  priceUpdatedAt DateTime?

  /// „Sau vinde cu X lei" pe un anunț de tip Schimb: proprietarul acceptă
  /// explicit, încă de la listare, și o ofertă în bani, fără ca anunțul să
  /// devină unul de vânzare (isForSale rămâne false, deci categoria din
  /// bibliotecă/browse rămâne „Schimb"). Null = doar schimb.
  swapSalePrice Decimal? @db.Decimal(10, 2)

  // Licitație (Milestone 3) - un al 4-lea tip de anunț, distinct de
  // isForSale/availableForSwap. Detaliile (preț curent, ofertant cel mai
  // mare, termen) stau pe modelul Auction, legat 1:1 - isAuction rămâne
  // doar ca flag rapid de filtrare la browse, fără să dubleze acele date.
  isAuction Boolean  @default(false)
  auction   Auction?

  // "Promoted Listings" (Premium, Milestone 5) - doar userii isPremium pot
  // seta acest flag (vezi togglePromoted în books.service.ts); anunțurile
  // promovate apar primele la sortarea implicită din browse.
  isPromoted Boolean @default(false)

  viewCount Int @default(0)

  /// Suprascriere manuală din consola de admin a scorului de interes
  /// (popularityScore), pentru corecții/promovări arbitrare - vezi
  /// ListingScoreService.scoresFor. Null = scorul rămâne cel calculat din
  /// ListingScoreEvent. Nu afectează exchangePotentialScore.
  manualScoreOverride Float?

  photos String[]

  /// URL-ul pozei principale afișate în feed/carduri. Poate fi una din
  /// `photos[]`, coperta oficială (`book.coverUrl`), sau o copertă externă
  /// aleasă din selectorul „Coperte recomandate" la add book. Null =>
  /// fallback pe prima poză, apoi pe coperta cărții. Vezi Batch 8.
  mainPhotoUrl String?

  /// Descriere per exemplar (Milestone 10) - independent de Book.description
  /// care e a operei. Max 256 char, validat în DTO.
  description String?

  /// Tag-uri (max 5, validat în DTO) - stil hashtag: „lectura de vară",
  /// „ediție rară", etc. Milestone 10.
  tags String[] @default([])

  /// Localitatea unde se face schimbul, distinctă de user.city (userul poate
  /// avea cărți în orașe diferite). Milestone 10.
  city String?

  // Soft-delete cu grace de 7 zile (vezi migration + BooksService.softDelete).
  deletedAt DateTime?

  /// Ascuns automat de sistemul de moderare după destule rapoarte (vezi
  /// ReportsService.applyAutoHide). Distinct de `deletedAt`, care e decizia
  /// proprietarului: anunțul ascuns iese din căutare, dar rămâne al lui și
  /// poate fi repus de un moderator.
  hiddenAt DateTime?

  // Setat true doar când un exchange se completează efectiv - blochează
  // „mark available" pe carte transferată. Vezi Milestone 10 + exchanges.
  permanentlyTransferred Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exchangeRequestsReceived ExchangeRequest[]    @relation("RequestedBook")
  exchangeRequestsOffered  ExchangeRequest[]    @relation("OfferedBook")
  exchangeBundleEntries    ExchangeBundleBook[]
  priceOffers              PriceOffer[]
  reports                  Report[]
  bookViews                BookView[]
  scoreEvents              ListingScoreEvent[]
  wishlistItems            WishlistItem[]

  // Lanțul de proveniență - dacă userul care a primit cartea (schimb/vânzare)
  // decide să o re-listeze, noul anunț ține minte anunțul din care provine,
  // ca istoricul să poată fi urmărit pe mai multe schimburi succesive.
  previousListingId String?
  previousListing   UserBook?  @relation("ListingChain", fields: [previousListingId], references: [id], onDelete: SetNull)
  nextListings      UserBook[] @relation("ListingChain")

  @@map("user_books")
}

enum AuctionStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model Auction {
  id String @id @default(uuid())

  userBookId String   @unique
  userBook   UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  startingPrice Decimal  @db.Decimal(10, 2)
  reservePrice  Decimal? @db.Decimal(10, 2)
  buyNowPrice   Decimal? @db.Decimal(10, 2)

  // currentPrice = startingPrice cât timp nu există nicio licitație - se
  // actualizează la fiecare bid nou, ca să nu fie nevoie să recalculăm
  // MAX(bids.amount) la fiecare citire.
  currentPrice Decimal @db.Decimal(10, 2)

  highestBidderId String?
  highestBidder   User?   @relation("AuctionHighestBidder", fields: [highestBidderId], references: [id], onDelete: SetNull)

  // Anti-sniping: un bid în ultimele 5 minute împinge termenul cu încă 5
  // minute (se repetă cât timp tot vin bid-uri târzii) - vezi placeBid în
  // auctions.service.ts. endsAt e deci mutabil, nu doar setat la creare.
  endsAt DateTime
  status AuctionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids    Bid[]
  watches AuctionWatch[]

  @@map("auctions")
}

/// Ofertele sunt anonime față de ceilalți licitatori (afișate ca "Ofertant
/// #N", ordinea primei apariții) dar vizibile integral pentru vânzător -
/// vezi anonymizeBids în auctions.service.ts. Nu există un preț minim de
/// increment - orice sumă strict mai mare decât currentPrice e validă.
model Bid {
  id String @id @default(uuid())

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  bidderId String
  bidder   User   @relation("AuctionBidder", fields: [bidderId], references: [id], onDelete: Cascade)

  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@map("bids")
}

model AuctionWatch {
  id String @id @default(uuid())

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([auctionId, userId])
  @@map("auction_watches")
}

/// O vizualizare a unei cărți de către un user autentificat - deduplicat
/// Termeni căutați (titlu-carte extern sau în bibliotecă), pentru "Popular
/// Searches" - un simplu log append-only, agregat la citire (vezi
/// getPopularSearches în books.service.ts), fără userId (nu ne interesează
/// cine a căutat, doar ce se caută des).
model SearchLog {
  id        String   @id @default(uuid())
  query     String
  createdAt DateTime @default(now())

  @@map("search_logs")
}

/// prin unique(userBookId, userId), ca refresh-urile repetate ale aceluiași
/// user să nu umfle numărul de vizitatori unici (viewCount de pe UserBook
/// rămâne totalul brut, cu tot cu refresh-uri).
model BookView {
  id         String   @id @default(uuid())
  userBookId String
  userBook   UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userBookId, userId])
  @@map("book_views")
}

enum ListingScoreEventKind {
  /// Prima deschidere a anunțului de către un viewer, în ultimele 30 de zile.
  UNIQUE_VIEW
  /// Deprecated - fostul „refresh în aceeași zi" (0.1p). Nu se mai scrie de la
  /// v2 (vezi RETURN_VISIT), păstrat doar ca evenimentele vechi din DB să nu
  /// invalideze coloana; expiră natural din fereastra de scor în 30 de zile.
  REVIEW
  /// Revenire reală (la ≥6h de la ultima vizită) - cap 3/user/30 zile, ca să
  /// nu se poată umfla scorul cu F5 sau navigare repetată.
  RETURN_VISIT
  /// Titlul a fost pus la favorite (wishlist).
  WISHLIST_ADD
  /// Cerere de schimb trimisă pentru acest anunț.
  EXCHANGE_REQUEST
  /// Ofertă de preț trimisă pentru acest anunț.
  BUY_OFFER
}

/// „Cele mai căutate" (Milestone 20) - scorul de interes al unui anunț.
/// Fiecare punct EXPIRĂ individual la 30 de zile după ce a fost câștigat, deci
/// nu putem ține un singur contor cumulat pe UserBook: logăm fiecare eveniment
/// cu timestamp și calculăm scorul ca SUM(points) WHERE createdAt > now()-30d.
/// `userId` e null pentru vizitatorii ne-autentificați (tratați ca o singură
/// entitate la deduplicare, ca la BookView) și e folosit DOAR ca să distingem
/// un view unic de o revenire - nu expunem niciodată cine a văzut ce.
/// Scorul e invizibil pentru userii normali; apare doar pentru admini.
model ListingScoreEvent {
  id String @id @default(uuid())

  userBookId String
  userBook   UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   ListingScoreEventKind
  points Float

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userBookId, createdAt])
  @@index([userBookId, userId, kind, createdAt])
  @@map("listing_score_events")
}

enum BookshelfStatus {
  READING
  WANT_TO_READ
  FINISHED
}

/// "Public Bookshelf" - statusul personal de citit al userului pentru o
/// carte din catalog, INDIFERENT dacă are sau nu un exemplar fizic
/// listat (spre deosebire de UserBook, care înseamnă "dețin o copie fizică
/// și o pot da la schimb/vânzare"). Un user poate marca "Vreau să citesc"
/// o carte pe care nici măcar n-a văzut-o vreodată la schimb pe platformă.
/// "Shared" din roadmap nu are o intrare aici - se derivă direct din
/// UserBook.availableForSwap (vezi getPublicBookshelf), ca să nu dubleze o
/// stare care există deja.
model BookshelfEntry {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  status BookshelfStatus

  /// Cartea e DEȚINUTĂ fizic de user, dar nu (neapărat) scoasă la schimb/vânzare.
  /// Distinct de UserBook, care înseamnă „am făcut un anunț cu ea": raftul
  /// personal din My Shelf arată în prim-plan exact aceste cărți (owned = true
  /// fără UserBook activ), ca userul să-și țină progresul la citit înainte de a
  /// decide dacă o listează. False pentru intrările venite din import CSV sau
  /// din butonul „vreau să citesc" de pe pagina unei cărți străine.
  owned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@map("bookshelf_entries")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
}

model PriceOffer {
  id String @id @default(uuid())

  buyerId String
  buyer   User   @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("OfferOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  userBookId String
  userBook   UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  amount  Decimal     @db.Decimal(10, 2)
  message String?
  status  OfferStatus @default(PENDING)

  // Expirare "leneșă" - nu există un job programat care baleiază periodic;
  // orice citire a unei oferte PENDING (getSentOffers/getReceivedOffers)
  // verifică expiresAt și trece oferta pe EXPIRED pe loc dacă a trecut
  // termenul, înainte de a răspunde. Simplu, fără dependință nouă
  // (@nestjs/schedule), suficient la scara aplicației.
  expiresAt DateTime?

  // Restul câmpurilor de mai jos oglindesc exact flow-ul de schimb (vezi
  // ExchangeRequest) - o vânzare cu bani tot presupune o întâlnire fizică, deci
  // are nevoie de aceeași programare/partajare de contact/safety-ack/confirmare
  // mutuală înainte ca acceptarea ofertei să transfere efectiv cartea.
  acceptedAt DateTime?

  meetingTime       DateTime?
  meetingLocation   String?
  meetingProposedBy String?
  meetingAcceptedAt DateTime?

  buyerContactPhone    String?
  ownerContactPhone    String?
  buyerContactSharedAt DateTime?
  ownerContactSharedAt DateTime?

  buyerSafetyAckAt DateTime?
  ownerSafetyAckAt DateTime?

  buyerDoneAt DateTime?
  ownerDoneAt DateTime?

  cancelReason  String?
  cancelDetails String?
  cancelledBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@map("price_offers")
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

model ExchangeRequest {
  id String @id @default(uuid())

  requesterId String
  requester   User   @relation("RequesterExchanges", fields: [requesterId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("OwnerExchanges", fields: [ownerId], references: [id], onDelete: Cascade)

  requestedBookId String
  requestedBook   UserBook @relation("RequestedBook", fields: [requestedBookId], references: [id], onDelete: Cascade)

  offeredBookId String?
  offeredBook   UserBook? @relation("OfferedBook", fields: [offeredBookId], references: [id], onDelete: SetNull)

  // Feature backlog #17: bundle transactions - un requester poate oferi mai
  // multe cărți ale sale într-un singur schimb, nu doar `offeredBookId`
  // (rămas ca prima carte oferită, pentru compatibilitate cu tot codul deja
  // scris în jurul lui). Restul cărților din pachet stau aici.
  additionalOfferedBooks ExchangeBundleBook[]

  offeredAmount Decimal? @db.Decimal(10, 2)

  status  ExchangeStatus @default(PENDING)
  message String?

  // Expirare "leneșă" - vezi comentariul de pe PriceOffer.expiresAt.
  expiresAt DateTime?

  requesterRatingForOwner Int?
  ownerRatingForRequester Int?
  requesterReviewForOwner String?
  ownerReviewForRequester String?

  // Rating pe dimensiuni - Communication/Punctuality se pot da mereu în
  // ambele direcții; Condition se dă doar de partea care CHIAR a primit o
  // carte fizică (requester primește mereu requestedBook; owner primește
  // offeredBook doar dacă schimbul a fost carte-contra-carte, nu bani).
  requesterCommunicationForOwner Int?
  requesterPunctualityForOwner   Int?
  requesterConditionForOwner     Int?
  ownerCommunicationForRequester Int?
  ownerPunctualityForRequester   Int?
  ownerConditionForRequester     Int?

  meetingTime     DateTime?
  meetingLocation String?

  // Programare cu accept/decline: cel care propune ora e reținut ca să știm
  // cui îi cerem confirmarea; meetingAcceptedAt rămâne null cât timp
  // propunerea așteaptă răspunsul celeilalte părți.
  meetingProposedBy String?
  meetingAcceptedAt DateTime?

  // Ancora pentru timeout-ul de 7 zile (job programat, nu expirare leneșă -
  // vezi expireStaleAccepted în exchanges.service.ts). Setat în accept().
  acceptedAt DateTime?

  // Detalii de contact partajate opțional de fiecare parte după acceptare;
  // numele/poza vin deja din User, telefonul e opțional - fallback-ul e
  // mereu "Message in app".
  requesterContactPhone    String?
  ownerContactPhone        String?
  requesterContactSharedAt DateTime?
  ownerContactSharedAt     DateTime?

  // Checkbox obligatoriu "I've read this" pe pagina de safety recommendations
  // - trebuie bifat de ambele părți înainte de a debloca "Ready to exchange".
  requesterSafetyAckAt DateTime?
  ownerSafetyAckAt     DateTime?

  // "Condition Photos" (feature backlog #14) - fiecare parte fotografiază
  // cartea ÎNAINTE de predare (în starea ACCEPTED, alături de safety-ack/
  // contact), ca dovadă a stării reale la momentul schimbului - închide
  // disputele de tip "mi-a venit deteriorată" fără să depindă doar de
  // cuvântul cuiva. Distinct de rating-ul de după (Condition 1-5), care
  // vine abia la finalul schimbului și nu documentează nimic vizual.
  requesterConditionPhotos String[] @default([])
  ownerConditionPhotos     String[] @default([])

  // Confirmare mutuală pentru Done: primul care apasă setează câmpul lui;
  // schimbul devine COMPLETED abia când sunt setate ambele.
  requesterDoneAt DateTime?
  ownerDoneAt     DateTime?

  // Motivul cancelului (formularul "What happened?") - reținut ca să poată fi
  // arătat celorlalți solicitanți ai aceleiași cărți când cererile lor se
  // redeschid automat.
  cancelReason  String?
  cancelDetails String?
  cancelledBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@map("exchange_requests")
}

/// Feature backlog #17: pachetul de cărți suplimentare oferite la un schimb
/// (dincolo de `ExchangeRequest.offeredBookId`, care rămâne prima/principala
/// carte oferită). Un rând per carte suplimentară din pachet.
model ExchangeBundleBook {
  id String @id @default(uuid())

  exchangeRequestId String
  exchangeRequest   ExchangeRequest @relation(fields: [exchangeRequestId], references: [id], onDelete: Cascade)

  userBookId String
  userBook   UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([exchangeRequestId, userBookId])
  @@map("exchange_bundle_books")
}

model Conversation {
  id String @id @default(uuid())

  userAId String
  userA   User   @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)

  userBId String
  userB   User   @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)

  // Arhivare și ștergere sunt per-participant, nu pentru toată conversația -
  // dacă A își arhivează sau șterge chatul, B trebuie să îl vadă mai departe
  // neatins. De aceea sunt câte două coloane, una pentru fiecare capăt.
  //
  // archivedAt = ascuns din lista principală, dar reapare la primul mesaj nou.
  // clearedAt  = „șterge chatul": conversația dispare din listă și mesajele
  //              de dinainte de acest moment nu se mai încarcă pentru el.
  //              Nu ștergem rândurile - celălalt participant păstrează
  //              istoricul complet, iar un chat raportat rămâne exportabil.
  userAArchivedAt DateTime?
  userBArchivedAt DateTime?
  userAClearedAt  DateTime?
  userBClearedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  reports  Report[]

  @@unique([userAId, userBId])
  @@map("conversations")
}

/**
 * „Chat with an admin" - o singură conversație per user cu ECHIPA de admini,
 * nu cu un admin anume (spre deosebire de `Conversation`, gândit pentru
 * perechi fixe A/B). Orice admin (User.isAdmin) poate citi și răspunde la
 * orice conversație - nu există „adminId" de proprietar. Userul obișnuit
 * are un singur inbox de tip ăsta (unique pe userId); adminii au ÎN PLUS
 * propriile conversații normale (`Conversation`) ca „inbox personal" - cele
 * două fluxuri sunt complet separate, nu se suprapun în UI sau în date.
 */
model AdminSupportConversation {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  // Un singur reper de citire per parte, nu per-admin: „citit" înseamnă
  // „vreun admin l-a văzut", suficient pentru un badge de neciit în lista
  // de admini - a ține evidența per-admin ar cere un join table fără să
  // aducă vreun beneficiu vizibil userului sau echipei.
  userLastReadAt  DateTime?
  adminLastReadAt DateTime?

  messages AdminSupportMessage[]

  @@map("admin_support_conversations")
}

model AdminSupportMessage {
  id String @id @default(uuid())

  conversationId String
  conversation   AdminSupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("AdminSupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Denormalizat direct pe mesaj (nu derivat din sender.isAdmin la citire):
  // dacă un admin își pierde ulterior rolul, istoricul conversației trebuie
  // să rămână corect din perspectiva „cine a răspuns ca admin la momentul respectiv".
  isFromAdmin Boolean @default(false)

  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("admin_support_messages")
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content  String?
  photo    String?
  location String?

  // Coordonate + oră propusă pentru întâlnire - setate doar pe mesajele de
  // locație (vezi "Trimite locația întâlnirii" din chat).
  locationLat Float?
  locationLng Float?
  meetingAt   DateTime?

  // Setat doar pe mesajul generat automat când cineva face o ofertă de preț
  // (vezi offers.service.ts#createOffer) - face oferta vizibilă și
  // acționabilă direct în chat, nu doar ca o notificare separată.
  priceOfferId String?
  priceOffer   PriceOffer? @relation(fields: [priceOfferId], references: [id], onDelete: SetNull)

  // Setat doar pe mesajul generat automat când cineva face o cerere de
  // schimb (vezi exchanges.service.ts#createRequest) - aceeași idee ca
  // priceOfferId, dar pentru schimb carte-contra-carte, nu preț.
  exchangeRequestId String?
  exchangeRequest   ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id], onDelete: SetNull)

  // Reply la un mesaj anterior. SetNull, nu Cascade: dacă mesajul citat
  // dispare, răspunsul rămâne - doar citatul se pierde (UI-ul afișează
  // „mesaj șters" când replyTo e null dar replyToId era setat).
  replyToId String?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  // Paginarea și căutarea în conversație merg mereu pe (conversationId,
  // createdAt) - fără index, fiecare deschidere de chat scanează tot tabelul.
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// De unde a ajuns titlul pe wishlist: adăugat manual (inima de pe anunț) sau
/// dintr-un „Yes" în Book Match. Permite despărțirea listei în „Alegerile mele"
/// / „Book Match" în UI. Un rând PERSONAL nu devine niciodată BOOK_MATCH -
/// alegerea explicită a userului are prioritate.
enum WishlistItemSource {
  PERSONAL
  BOOK_MATCH
}

model WishlistItem {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// Anunțul de pe care a fost apăsată inima. Favoritul e legat de EXEMPLAR,
  /// nu de titlu: dacă „Ion" e listat de trei useri, inima trebuie să rămână
  /// aprinsă doar pe anunțul pus la favorite, nu pe toate trei.
  /// NULL = dorință la nivel de titlu („vreau cartea, de la oricine"): așa
  /// intră rândurile din Book Match și tot acolo ajung cele ale căror anunț
  /// a dispărut între timp (onDelete: SetNull).
  userBookId String?
  userBook   UserBook? @relation(fields: [userBookId], references: [id], onDelete: SetNull)

  source WishlistItemSource @default(PERSONAL)

  createdAt DateTime @default(now())

  /// userBookId intră în cheia unică: două anunțuri diferite ale aceluiași
  /// titlu sunt două favorite distincte. Postgres tratează NULL-urile ca
  /// distincte, deci unicitatea rândurilor „de titlu" (userBookId NULL) e
  /// impusă în cod (vezi WishlistService.add).
  @@unique([userId, bookId, userBookId])
  @@index([userId, bookId])
  @@map("wishlist_items")
}

/// Căutare salvată (feature backlog #6) - "SF, sub 30 lei, în Cluj". Distinct
/// de WishlistItem (o carte anume) - aici userul salvează niște CRITERII,
/// nu un titlu, și e anunțat la orice anunț nou care le satisface. Domeniul
/// e intenționat restrâns la genre/city/maxPrice (nu tot BrowseFilters) -
/// astea sunt câmpurile pe care le putem verifica automat la un anunț nou:
/// genre + city sunt cunoscute la creare, maxPrice abia când anunțul trece
/// pe vânzare (vezi notifySavedSearches în books.service.ts).
model SavedSearch {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label    String
  genre    String?
  city     String?
  maxPrice Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("saved_searches")
}

// ---------------------------------------------------------------------------
// Book Match (swipe) - log de evenimente + scoruri derivate pe 3 dimensiuni.
//
// Modelul e același ca la ListingScoreEvent: nu ținem contoare cumulate (nu am
// ști ce parte din ele s-a „stins" cu timpul), ci logăm fiecare swipe și
// recalculăm scorurile din istoric, cu o pondere care scade exponențial
// (jumătate la fiecare 180 de zile). Diferența față de listing score e că acolo
// punctele expiră brusc la 14 zile, aici se sting continuu.
// ---------------------------------------------------------------------------

enum BookSwipeAction {
  YES
  NO
  SKIP
}

model BookSwipe {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  action BookSwipeAction

  /// Generat de client, grupează swipe-urile unei sesiuni. O carte nu poate
  /// reapărea în aceeași sesiune, indiferent de acțiune.
  sessionId String

  /// Cartea a fost servită ca „discovery" (gen neutru), nu ca potrivire de
  /// profil - păstrat pentru analytics, ca să vedem dacă wildcard-urile prind.
  isDiscovery Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, bookId])
  @@index([userId, createdAt])
  @@index([userId, sessionId])
  @@map("book_swipes")
}

model UserGenreScore {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  genre String
  score Float  @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, genre])
  @@map("user_genre_scores")
}

model UserAuthorScore {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  author String
  score  Float  @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, author])
  @@map("user_author_scores")
}

model UserEraScore {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Bucket derivat din books.publishedYear - vezi eraForYear().
  era   String
  score Float  @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, era])
  @@map("user_era_scores")
}

/// Istoricul recalibrărilor („vreau alte recomandări"), doar pentru debug și
/// analytics: snapshot cu scorurile înainte și după compresie.
model RecalibrationLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scoresBefore Json
  scoresAfter  Json

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("recalibration_logs")
}

enum NotificationType {
  WISHLIST_BOOK_AVAILABLE
  EXCHANGE_REQUEST_RECEIVED
  EXCHANGE_REQUEST_ACCEPTED
  EXCHANGE_REQUEST_REJECTED
  EXCHANGE_MEETING_SCHEDULED
  NEW_MESSAGE
  PRICE_OFFER_RECEIVED
  PRICE_OFFER_ACCEPTED
  PRICE_OFFER_REJECTED
  FOLLOWED_USER_NEW_BOOK
  NEARBY_BOOK_LISTED
  // Carte listată într-un gen pe care userul l-a bifat în profilul de cititor.
  INTEREST_BOOK_LISTED
  PRICE_CHANGED
  OUTBID
  AUCTION_WON
  AUCTION_ENDED
  EXCHANGE_MEETING_PROPOSED
  EXCHANGE_MEETING_ACCEPTED
  EXCHANGE_MEETING_DECLINED
  EXCHANGE_CONTACT_SHARED
  EXCHANGE_READY
  EXCHANGE_POSTPONED
  EXCHANGE_DONE_PENDING_CONFIRMATION
  EXCHANGE_DONE_DISPUTED
  EXCHANGE_COMPLETED
  EXCHANGE_CANCELLED
  EXCHANGE_BOOK_PENDING
  EXCHANGE_REOPENED
  SAVED_SEARCH_MATCH
  SERIES_VOLUME_AVAILABLE
}

/// Token FCM al unui dispozitiv (telefon/tabletă) pe care userul e logat, ca
/// să putem trimite push notifications. Un user poate avea mai multe
/// dispozitive; același token e reînregistrat (upsert) la fiecare login sau
/// refresh al tokenului de FCM - nu creăm duplicate.
model DeviceToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String @unique
  platform String // "android" | "ios" | "web"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  message String
  data    Json?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("notifications")
}

/// Pre-înscriere pentru lansarea Android. Simplu email opt-in cu deduplicare
/// case-insensitive; anunțul de lansare se trimite tuturor odată ce APK-ul e
/// live. Vezi PreRegistrationService.
model PreRegistration {
  id         String   @id @default(uuid())
  email      String
  /// Copie lowercase pentru dedup case-insensitive - Postgres nu dă unique
  /// citext ieftin, iar un index unic pe lower(email) e mai fragil în Prisma.
  emailLower String   @unique
  userId     String?
  createdAt  DateTime @default(now())

  @@map("pre_registrations")
}

/**
 * Milestone 17: audit trail for security-relevant events (login, password
 * changes, premium/admin actions). userId is nullable + SetNull on delete
 * (not the usual project-wide Cascade for new User relations, see
 * project_account_deletion memory) - deliberately, since an audit log
 * should survive the account it was about, not disappear with it.
 */
model SecurityEvent {
  id        String   @id @default(uuid())
  type      String
  userId    String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type, createdAt])
  @@map("security_events")
}

/**
 * Acces per-user la funcții încă în rulare (beta / acces preferențial),
 * acordat manual din panoul de admin - vezi FEATURE_FLAG_KEYS din
 * common/constants/feature-flags.ts pentru cheile cunoscute.
 * Un tabel separat, nu o coloană `String[]` pe User, ca să putem revoca
 * fără să rescriem lista întreagă și ca să știm cine/când a acordat accesul
 * (createdAt/updatedAt). Rândul se păstrează și cu enabled=false: „revocat
 * explicit" e informație utilă, iar cheile necunoscute sunt ignorate la
 * citire, deci lista se poate extinde fără migrare.
 */
model UserFeatureFlag {
  id      String  @id @default(uuid())
  userId  String
  flagKey String
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flagKey])
  @@index([flagKey])
  @@map("user_feature_flags")
}
