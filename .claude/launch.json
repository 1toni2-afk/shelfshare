{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-beta",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "--port",
        "5182"
      ],
      "port": 5182
    },
    {
      "name": "web-audit",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "--port",
        "5184",
        "--strictPort"
      ],
      "port": 5184
    },
    {
      "name": "beta-server-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.BETA_PORT='5971'; process.env.BETA_API_URL='https://api.shelfshare.ro'; require('./scripts/beta-server.js')"
      ],
      "port": 5971
    }
  ]
}