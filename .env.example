# Postgres
POSTGRES_USER=shelfshare
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=shelfshare
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://shelfshare:change_me_in_production@postgres:5432/shelfshare?schema=public

NODE_ENV=development

# Frontend (pentru linkurile din email-uri si CORS)
FRONTEND_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Proxy / IP-ul real al clientului
# ---------------------------------------------------------------------------
# "true" DOAR daca aplicatia sta in spatele unui proxy de incredere (in
# productie: Cloudflare Tunnel). Atunci IP-ul clientului e citit din
# CF-Connecting-IP / X-Forwarded-For in loc de socket.
#
# Fara asta, in spatele tunelului toti userii apar cu acelasi IP, deci:
#   - limitele de pe /auth/* (login, forgot-password) devin o singura galeata
#     globala in loc de una per client;
#   - jurnalul de securitate (LOGIN_FAILED, ACCOUNT_LOCKED) noteaza IP-ul
#     tunelului, deci nu poate spune de unde a venit un atac.
#
# NU o pune pe "true" daca portul aplicatiei e accesibil direct din retea:
# oricine ar putea sa-si aleaga singur IP-ul aparent trimitand header-ul.
# In docker-compose.prod.yml portul e legat la 127.0.0.1 tocmai de aceea.
TRUST_PROXY=false

# Jurnalul global (interactiuni user-user si user-admin) - fisiere text, un
# fisier pe zi, in foldere an/luna. Mesajele merg intr-un fisier separat
# (logs/chat/...), fara continut daca ACTIVITY_LOG_CHAT_CONTENT nu e "true".
# In productie folderul e montat pe host prin docker-compose.prod.yml.
ACTIVITY_LOG_DIR=
ACTIVITY_LOG_TZ=Europe/Bucharest
ACTIVITY_LOG_CHAT_CONTENT=false
ACTIVITY_LOG_DISABLED=false

# JWT - genereaza secrete lungi si random, diferite intre ele
# Poti genera unul cu: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_generate_a_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_me_generate_a_different_random_secret
JWT_REFRESH_EXPIRY=30d

# Resend (email) - cheia se ia de pe resend.com dupa ce iti verifici domeniul
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=onboarding@resend.dev

# Google OAuth - se genereaza in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ATENTIE: doar pentru testare locala/self-hosted, NICIODATA pe productie cu
# useri reali. Cand e "true", butonul "Sterge contul" din Settings sterge
# contul definitiv PE LOC, fara cele 15 zile de grace period (vezi
# DELETION_GRACE_PERIOD_DAYS in account-deletion.service.ts) - orice user
# real care apasa acel buton isi pierde datele instant, fara fereastra de
# anulare ceruta de Google Play/GDPR. Lasa pe "false" (sau sterge linia) in
# afara unei sesiuni de test, si opreste-o la loc imediat dupa.
INSTANT_ACCOUNT_DELETION=false

# ---------------------------------------------------------------------------
# Backup (vezi scripts/backup.sh)
# ---------------------------------------------------------------------------
# Parola cu care se cripteaza dump-ul bazei si arhiva MinIO (gpg, AES256).
# OBLIGATORIE: scriptul refuza sa ruleze fara ea.
#
# Dump-ul contine toata tabela User - emailuri, nume, orase, hash-uri de
# parola - iar o copie ajunge pe discul extern. Necriptat, e suficient sa se
# piarda acel disc ca sa se piarda toata baza de useri.
#
# Genereaza cu: openssl rand -base64 32
# PASTREAZ-O IN AFARA SERVERULUI (password manager). Daca o pierzi, backup-urile
# devin nerecuperabile - nu exista alta cheie.
BACKUP_ENCRYPTION_PASSPHRASE=

# Portita explicita pentru un backup necriptat deliberat (ex. restaurare de
# test pe o masina locala). Lasa "false" in functionare normala.
BACKUP_ALLOW_UNENCRYPTED=false
